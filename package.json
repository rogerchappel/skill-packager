{
  "name": "skill-packager",
  "version": "0.1.0",
  "description": "Scaffold and validate reusable agent skill packages.",
  "type": "module",
  "bin": {
    "skill-packager": "./bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "docs",
    "examples",
    "fixtures",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/*.js bin/cli.js tests/*.test.js",
    "build": "node scripts/build.js",
    "smoke": "node bin/cli.js --help && node scripts/smoke.js",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm test && npm run check && npm run build && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agent-skill",
    "agents",
    "cli",
    "dry-run"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/skill-packager.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/skill-packager/issues"
  },
  "homepage": "https://github.com/rogerchappel/skill-packager#readme"
}
